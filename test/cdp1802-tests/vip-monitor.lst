804B ;              0143   .. Initialize the registers to start the operating system
804B 92;            0144           GHI     R2
804C B3;            0145           PHI     R3
804D F851;          0146           LDI     A.0(MAIN)
804F A3;            0147           PLO     R3
8050 D3;            0148           SEP     R3              .. go to MAIN
8051 90;            0149   MAIN:   GHI     R0
8052 B2;            0150           PHI     R2              .. R2.1 = top of memory (stack)
8053 BB;            0151           PHI     RB              .. RB.1 = top of memory (video)
8054 BD;            0152           PHI     RD              .. RD.1 = top of memory (display mem)
8055 F881;          0153           LDI     #81             .. point subroutines to page 2 of ROM
8057 B1;            0154           PHI     R1              .. #81 -> R1.1
8058 B4;            0155           PHI     R4              .. #81 -> R4.1
8059 B5;            0156           PHI     R5              .. #81 -> R5.1
805A B7;            0157           PHI     R7              .. #81 -> R7.1
805B BA;            0158           PHI     RA              .. #81 -> RA.1
805C BC;            0159           PHI     RC              .. #81 -> RC.1
