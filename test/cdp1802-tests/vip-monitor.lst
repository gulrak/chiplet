8160 ;              0460   
8160 ;              0461   .. decrement timers every video frame (~16ms)
8160 ;              0462   ..      R8.1 is a regular timer
8160 ;              0463   ..      R8.0 is the tone timer
8160 ;              0464   
8160 98;            0465   TIMER:  GHI     R8
8161 3267;          0466           BZ      TIMX
8163 AB;            0467           PLO     RB
8164 2B;            0468           DEC     RB
8165 8B;            0469           GLO     RB
8166 B8;            0470           PHI     R8              .. dec timer.1 without changing DF
8167 88;            0471   TIMX:   GLO     R8
